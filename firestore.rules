rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para campañas (cualquiera puede leer, solo admins pueden escribir)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reglas para donaciones (cualquiera puede leer, solo admins pueden escribir)
    match /donations/{donationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
