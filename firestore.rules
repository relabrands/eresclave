rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para campañas (cualquiera puede leer, solo admins pueden escribir)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Solicitudes de misiones (aplicaciones)
      match /applications/{applicationId} {
        allow read: if request.auth != null; // Volunteers read their own via collectionGroup, Admins read all
        allow write: if request.auth != null; // Simpler for now, users can apply, admins can approve
      }
    }
    
    // Reglas para donaciones (cualquiera puede leer, solo admins pueden escribir)
    match /donations/{donationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reglas para contactos (solo admins pueden leer y escribir)
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Reglas para voluntarios
    match /volunteers/{volunteerId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == volunteerId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
